# Copy this file to .env.local (which is gitignored) and fill in the values
# below. Restart `npm start` after editing so Create React App picks up the
# values. Never put real secrets in this file (.env.example) — it's committed
# to the repo. Real values belong only in your local .env.local.

# Firebase — console.firebase.google.com > Project settings
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# GoHighLevel — Settings > Business Profile > API Keys (for REACT_APP_GHL_API_KEY)
# and Settings > Company (for your Location ID)
#
# WARNING: this key is called directly from the browser (see src/api/ghl.js)
# and will be visible to anyone who inspects the deployed app. Prototype
# only — do not use a real key here until GHL calls are moved behind a
# server-side proxy.
REACT_APP_GHL_API_KEY=
REACT_APP_GHL_LOCATION_ID=

# Stripe — no env var needed here. Payment links are created by the
# createPaymentLink Cloud Function (functions/index.js), which holds the
# Stripe SECRET key in Firebase Secret Manager, not in this file:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase deploy --only functions
# The client only needs REACT_APP_FIREBASE_* above to call it.
