# Copy this file to .env.local (which is gitignored) and fill in the values
# from your Firebase project: console.firebase.google.com > Project settings.
# Restart `npm start` after editing so Create React App picks up the values.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
